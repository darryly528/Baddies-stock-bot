modules = ["nodejs-20"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[[ports]]
localPort = 3001
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 4200

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 25181
externalPort = 3003

[[ports]]
localPort = 25182
externalPort = 3000

[[ports]]
localPort = 25183
externalPort = 3001

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server & Discord Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "API Server & Discord Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Baddies-stock-bot-2/artifacts/api-server && PORT=8080 pnpm run dev"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Baddies-stock-bot-2/artifacts/baddies-store && PORT=5000 BASE_PATH=/ pnpm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[userenv]

[userenv.shared]
DISCORD_CLIENT_ID = "1481478188369576016"

[deployment]
run = ["sh", "-c", "pnpm install PORT=3000 DISCORD_BOT_TOKEN=MTQ4MTQ3ODE4ODM2OTU3NjAxNg.GinU6I.zJf7RVUVtoI66_DQ-0F7dK7oqrei90Ye95YMAQ pnpm --filter @workspace/api-server run dev"]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "pnpm install && pnpm build"]
